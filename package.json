{
  "name": "boshqar-uz-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "boshqar.uz Universal Business Management System Monorepo",
  "workspaces": [
    "ubms-backend",
    "ubms-frontend",
    "ubms-telegram-bot"
  ],
  "scripts": {
    "build": "npm run build:frontend",
    "dev:backend": "npm --prefix ubms-backend run start:dev",
    "dev:frontend": "npm --prefix ubms-frontend run dev",
    "dev:bot": "npm --prefix ubms-telegram-bot run dev",
    "build:backend": "npm --prefix ubms-backend run build",
    "build:frontend": "npm --prefix ubms-frontend run build",
    "build:bot": "npm --prefix ubms-telegram-bot run build",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:bot",
    "test:backend": "npm --prefix ubms-backend run test",
    "test": "npm run test:backend"
  },
  "overrides": {
    "tar": "^7.5.3",
    "lodash": "^4.17.21",
    "js-yaml": "^4.1.0",
    "qs": "^6.14.0",
    "glob": "^10.4.5",
    "picomatch": "^4.0.3",
    "tmp": "^0.2.3",
    "body-parser": "^1.20.3",
    "uuid": "^11.1.1"
  }
}
