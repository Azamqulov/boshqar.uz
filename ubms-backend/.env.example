PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://username:password@localhost:5432/ubms_db?sslmode=prefer"

# Kamida 32 belgidan iborat bo'lishi shart.
# Production uchun generatsiya qilish: openssl rand -hex 32
JWT_SECRET="boshqar_uz_jwt_secure_secret_key_minimum_32_chars_2026"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="30d"

# CORS ruxsat etilgan domenlar (vergul bilan ajratilgan)
# Production uchun: CORS_ORIGINS="https://boshqar.uz,https://app.boshqar.uz,tauri://localhost"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,tauri://localhost"

# Seeding orqali yaratiladigan default administrator paroli (Development uchun)
SEED_ADMIN_PASSWORD="Admin12345!"
