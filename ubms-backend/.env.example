# ══════════════════════════════════════════════════════════════════
#  boshqar.uz Backend — Environment Configuration (.env.example)
#  Localda: Ushbu fayldan nusxa olib .env yarating (git'ga kirmaydi)
#  Render / Hostingda: Environment Variables bo'limiga kiriting
# ══════════════════════════════════════════════════════════════════

# Server Port & Environment
PORT=4000
NODE_ENV=development

# PostgreSQL Ma'lumotlar Bazasi (Neon / Supabase / Render PostgreSQL)
# Production uchun sslmode=require bo'lishi shart
DATABASE_URL="postgresql://username:password@localhost:5432/ubms_db?sslmode=prefer"
DIRECT_URL="postgresql://username:password@localhost:5432/ubms_db?sslmode=prefer"

# JWT Xavfsizlik Kaliti (Kamida 32-64 ta tasodifiy belgilar)
# Yangi kalit yaratish buyrug'i: openssl rand -hex 32
JWT_SECRET="boshqar_uz_jwt_secure_secret_key_minimum_32_chars_2026"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="30d"

# CORS — Ruxsat berilgan domenlar (Vergul bilan ajratilgan)
# Production uchun: CORS_ORIGINS="https://boshqar.uz,https://app.boshqar.uz,https://boshqar-frontend.onrender.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,tauri://localhost"

# Redis Cache Store (Docker yoki Cloud Redis)
REDIS_URL="redis://localhost:6379"

# Sentry Error Monitoring (Ixtiyoriy)
# SENTRY_DSN="https://YOUR_KEY@sentry.io/PROJECT_ID"

# SerpApi — Google Images Search API (serpapi.com)
SERPAPI_KEY=""

# Google Custom Search API — Real Product Image Search (searchType=image)
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

