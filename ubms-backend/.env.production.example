# ════════════════════════════════════════════════════
#  boshqar.uz Backend — Production Environment
#  Bu faylni serverda yarating, GitHub'ga push qilmang!
# ════════════════════════════════════════════════════

PORT=4000
NODE_ENV=production
APP_VERSION=2.0.0

# PostgreSQL (Neon / production DB)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT
JWT_SECRET="MINIMUM_64_CHAR_RANDOM_SECRET_HERE"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="30d"

# CORS (production domain)
CORS_ORIGINS="https://boshqar.uz,https://www.boshqar.uz"

# Redis (agar Redis ishlatilsa)
# REDIS_URL="redis://boshqar-redis:6379"

# Sentry Error Monitoring (https://sentry.io dan DSN oling)
SENTRY_DSN="https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID"
